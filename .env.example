# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Optional OpenWeatherMap key (falls back to open-meteo if unset)
VITE_OPENWEATHER_API_KEY=""

# Offline map packs install from a local zip on the phone
# (Download/ImageneCycle/{slug}-maps.zip or Browse). CDN vars below are unused for install.
# VITE_MAP_PACK_BASE_URL=""
# VITE_MAP_CATALOG_URL=""

# Strava OAuth (Express server — never expose CLIENT_SECRET to Vite)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3001/api/strava/callback"
STRAVA_PORT=3001
