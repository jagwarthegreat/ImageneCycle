{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "maps:ph": "node scripts/fetch-philippines-map.mjs",
    "maps:sh": "node scripts/fetch-philippines-map.mjs",
    "maps:extract": "node scripts/fetch-country-map.mjs",
    "maps:contours": "node scripts/build-contour-pack.mjs",
    "maps:stubs": "node scripts/write-sea-pack-stubs.mjs",
    "maps:verify": "node scripts/verify-offline-maps.mjs",
    "maps:guard": "node scripts/guard-no-bundled-pmtiles.mjs",
    "maps:zip": "node scripts/zip-country-map.mjs",
    "build:release": "npm run maps:guard && vite build",
    "icons:gen": "node scripts/generate-app-icons.mjs",
    "android:bump": "node scripts/android-bump-version.mjs",
    "android:build:debug": "npm run android:bump && npm run build && npx cap sync android && npm run android:assemble:debug",
    "android:assemble:debug": "node scripts/android-assemble-debug.mjs",
    "android:install:debug": "node scripts/android-install-debug.mjs"
  },
