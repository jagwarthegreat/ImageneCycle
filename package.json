    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "dotenv": "^17.2.3",
    "egm96-universal": "^1.1.1",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
